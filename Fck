<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Jordan 4 Store</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #111;
      color: #fff;
      text-align: center;
    }

    h1 {
      margin-top: 30px;
      font-size: 2.5em;
    }

    .carousel-container {
      position: relative;
      width: 300px;
      height: 300px;
      margin: 40px auto;
      perspective: 1000px;
    }

    .carousel {
      width: 100%;
      height: 100%;
      position: absolute;
      transform-style: preserve-3d;
      transition: transform 1s;
    }

    .carousel img {
      width: 300px;
      height: 300px;
      position: absolute;
      top: 0;
      left: 0;
      object-fit: cover;
      border-radius: 20px;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }

    .carousel img:nth-child(1) {
      transform: rotateY(0deg) translateZ(400px);
    }

    .carousel img:nth-child(2) {
      transform: rotateY(120deg) translateZ(400px);
    }

    .carousel img:nth-child(3) {
      transform: rotateY(240deg) translateZ(400px);
    }

    .controls {
      margin-top: 20px;
    }

    button {
      padding: 10px 20px;
      font-size: 16px;
      background: #ff2d2d;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin: 5px;
      transition: background 0.3s;
    }

    button:hover {
      background: #e60000;
    }

    .buy {
      margin-top: 30px;
      font-size: 18px;
    }
  </style>
</head>
<body>

  <h1>Jordan 4 Collection</h1>

  <div class="carousel-container">
    <div class="carousel" id="carousel">
      <img src="https://static.nike.com/a/images/t_PDP_864_v1/f_auto,q_auto:eco/14232190-ea62-47f8-922b-f3b328bf5d6c/air-jordan-4-retro-mens-shoes-3w73Df.png" alt="Jordan 1">
      <img src="https://static.nike.com/a/images/t_PDP_864_v1/f_auto,q_auto:eco/c3c1a51e-3fcb-48e6-a2e8-bb31fd8babc6/air-jordan-4-retro-mens-shoes-RvfNwb.png" alt="Jordan 2">
      <img src="https://static.nike.com/a/images/t_PDP_864_v1/f_auto,q_auto:eco/3c9018cb-6f68-40ff-9e03-b41f01b39b1f/air-jordan-4-retro-mens-shoes-H7ZvJ4.png" alt="Jordan 3">
    </div>
  </div>

  <div class="controls">
    <button onclick="rotateCarousel(-1)">◀ Anterior</button>
    <button onclick="rotateCarousel(1)">Siguiente ▶</button>
  </div>

  <div class="buy">
    <p>Precio: $220 USD</p>
    <button>Comprar ahora</button>
  </div>

  <script>
    let angle = 0;
    function rotateCarousel(direction) {
      angle += direction * 120;
      document.getElementById('carousel').style.transform = `rotateY(${angle}deg)`;
    }
  </script>

</body>
</html>
